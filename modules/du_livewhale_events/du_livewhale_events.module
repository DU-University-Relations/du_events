<?php

/**
 * @file
 * Provides LiveWhale event widget Paragraph rendering.
 */

/**
 * The staging script used by a new module installation.
 */
const DU_LIVEWHALE_EVENTS_DEFAULT_SCRIPT_URL = 'https://du-staging.lwcal.com/livewhale/theme/core/scripts/lwcw.js';

/**
 * The required path for the LiveWhale widget loader.
 */
const DU_LIVEWHALE_EVENTS_SCRIPT_PATH = '/livewhale/theme/core/scripts/lwcw.js';

/**
 * Determines whether a value is a supported LiveWhale widget script URL.
 *
 * @param mixed $url
 *   The URL to validate.
 *
 * @return bool
 *   TRUE when the value is an absolute HTTPS URL with the expected path.
 */
function du_livewhale_events_script_url_is_valid($url) {
  if (!is_string($url) || filter_var($url, FILTER_VALIDATE_URL) === FALSE) {
    return FALSE;
  }

  if (strtolower((string) parse_url($url, PHP_URL_SCHEME)) !== 'https') {
    return FALSE;
  }

  return parse_url($url, PHP_URL_PATH) === DU_LIVEWHALE_EVENTS_SCRIPT_PATH;
}

/**
 * Determines whether a value is a supported container maximum width.
 *
 * @param mixed $max_width
 *   The configured CSS length, or an empty value to disable the constraint.
 *
 * @return bool
 *   TRUE when the value is empty or a positive supported CSS length.
 */
function du_livewhale_events_container_max_width_is_valid($max_width) {
  if (!is_string($max_width)) {
    return FALSE;
  }

  $max_width = trim($max_width);
  if ($max_width === '') {
    return TRUE;
  }

  if (!preg_match('/^((?:\d+(?:\.\d+)?|\.\d+))(px|rem|em|%|vw|vh|vmin|vmax|ch)$/iD', $max_width, $matches)) {
    return FALSE;
  }

  return (float) $matches[1] > 0;
}

/**
 * Implements hook_library_info_build().
 */
function du_livewhale_events_library_info_build() {
  $config = \Drupal::config('du_livewhale_events.settings');
  $script_url = $config->get('script_url');

  // Protect rendering from an invalid settings.php override or stale config.
  if (!du_livewhale_events_script_url_is_valid($script_url)) {
    $script_url = DU_LIVEWHALE_EVENTS_DEFAULT_SCRIPT_URL;
  }

  $dependencies = ['du_livewhale_events/base'];
  if ($config->get('loading_placeholder_enabled') ?? TRUE) {
    $dependencies[] = 'du_livewhale_events/loading';
  }

  return [
    'widget' => [
      'version' => '1.x',
      'js' => [
        $script_url => [
          'type' => 'external',
          'minified' => TRUE,
          'attributes' => [
            'id' => 'lw_lwcw',
          ],
        ],
      ],
      'dependencies' => $dependencies,
    ],
  ];
}

/**
 * Builds the data-options value used by a LiveWhale widget.
 *
 * LiveWhale uses ampersands between options and pipes between multiple values
 * for one option. Encoding each group separately preserves the pipe separator
 * while protecting reserved characters in a group name.
 *
 * @param mixed $widget_id
 *   The saved LiveWhale widget ID.
 * @param array $groups
 *   LiveWhale group names.
 * @param mixed $options_override
 *   An optional complete data-options value. When populated, this replaces the
 *   generated widget ID, format, and groups.
 *
 * @return string
 *   The data-options value, or an empty string for an invalid widget ID or
 *   override.
 */
function du_livewhale_events_build_options(
  $widget_id,
  array $groups = [],
  $options_override = ''
) {
  // An empty field value may reach preprocessing as NULL.
  if ($options_override === NULL) {
    $options_override = '';
  }

  if (!is_string($options_override)) {
    return '';
  }

  $trimmed_override = trim($options_override);
  if ($trimmed_override !== '') {
    // Keep the override a single plain-text attribute value. Twig provides the
    // HTML escaping when it renders the data-options attribute.
    if (preg_match('/[\x00-\x1F\x7F]/', $options_override)) {
      return '';
    }

    return $trimmed_override;
  }

  $valid_id = filter_var($widget_id, FILTER_VALIDATE_INT, [
    'options' => ['min_range' => 1],
  ]);

  if ($valid_id === FALSE) {
    return '';
  }

  $options = [
    'id=' . $valid_id,
    'format=html',
  ];
  $encoded_groups = [];

  foreach ($groups as $group) {
    $group = trim((string) $group);
    if ($group === '') {
      continue;
    }

    // Keep spaces readable like LiveWhale's examples while URL-encoding
    // reserved characters such as ampersands and literal pipes.
    $encoded_groups[] = str_replace('%20', ' ', rawurlencode($group));
  }

  if ($encoded_groups) {
    $options[] = 'group=' . implode('|', $encoded_groups);
  }

  return implode('&', $options);
}

/**
 * Implements hook_theme().
 */
function du_livewhale_events_theme($existing, $type, $theme, $path) {
  return [
    'paragraph__du_livewhale_events' => [
      'template' => 'paragraph--du-livewhale-events',
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the DU LiveWhale Events Paragraph.
 */
function du_livewhale_events_preprocess_paragraph__du_livewhale_events(array &$variables) {
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_du_livewhale_widget_id')) {
    return;
  }

  $widget_id = $paragraph->get('field_du_livewhale_widget_id')->value;
  $groups = [];
  $options_override = '';

  if ($paragraph->hasField('field_du_livewhale_groups')) {
    foreach ($paragraph->get('field_du_livewhale_groups') as $item) {
      $groups[] = $item->value;
    }
  }

  if ($paragraph->hasField('field_du_livewhale_options')) {
    $options_override = $paragraph->get('field_du_livewhale_options')->value;
  }

  $variables['du_livewhale_options'] = du_livewhale_events_build_options(
    $widget_id,
    $groups,
    $options_override
  );

  if ($variables['du_livewhale_options'] !== '') {
    $config = \Drupal::config('du_livewhale_events.settings');
    $minimum_height = filter_var($config->get('minimum_height'), FILTER_VALIDATE_INT, [
      'options' => [
        'default' => 320,
        'min_range' => 0,
        'max_range' => 2000,
      ],
    ]);

    $variables['du_livewhale_loading_placeholder_enabled'] = $config->get('loading_placeholder_enabled') ?? TRUE;
    $variables['du_livewhale_minimum_height'] = $minimum_height;
    $variables['du_livewhale_loading_text'] = trim((string) $config->get('loading_text')) ?: 'Loading events…';
    $container_max_width = trim((string) $config->get('container_max_width'));
    if (!du_livewhale_events_container_max_width_is_valid($container_max_width)) {
      $container_max_width = '';
    }
    $variables['du_livewhale_container_max_width'] = $container_max_width;
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $config->getCacheTags()
    );

    // Drupal deduplicates libraries when multiple widgets appear on one page.
    $variables['#attached']['library'][] = 'du_livewhale_events/widget';
  }
}
